# Maintainer: dvjn <git@dvjn.dev>

pkgbase=dval
pkgname=("dval-base" "dval-desktop")
pkgver=0.1.4
pkgrel=1
arch=("any")
url="https://github.com/dvjn/dval"
license=("MIT")

source=("dval" "greetd-config.toml" "greetd-greeter.pam")
sha256sums=("dac1b9d8fe792af934560e25d4a6a20cdfa56264f768853f0b2f673d08f7af5e"
            "9c5efee888e573b818a08a886a7d44f400f57a5bbbcdbbf5d309c8c48fb85287"
            "e9eb324bfb957664761c6527b2632ed1bb0bb30e9818a3946f72f36661b8e767")

package_dval-base() {
    pkgdesc="dvjn's artix linux base (metapackage)"

    depends=(
        "base-devel"
        "git"
        "aurutils"
        "neovim"
        "man-db"
        "man-pages"
        "openssh"
        "openssh-dinit"
        "connman"
        "connman-dinit"
        "btrfs-progs"
        "sudo"
    )

    install -Dm755 "$srcdir/dval" "$pkgdir/usr/bin/dval"
}

package_dval-desktop() {
    pkgdesc="dvjn's artix linux desktop (metapackage)"

    backup=("etc/pam.d/greetd-greeter")
    install="dval-desktop.install"

    depends=(
        "dval-base"
        "dms-shell"
        "greetd-dms-greeter"
        "niri"
        "greetd"
        "greetd-dinit"
        "xdg-desktop-portal-gnome"
        "xdg-desktop-portal-gtk"
        "pipewire"
        "pipewire-pulse"
        "pipewire-jack"
        "wireplumber"
        "userspawn-dinit"
        "pipewire-dinit"
        "pipewire-pulse-dinit"
        "wireplumber-dinit"
        "power-profiles-daemon-dinit"
        "cliphist"
        "wl-clipboard"
        "slurp"
        "qt6-multimedia-ffmpeg"
        "accountsservice"
        "ghostty"
        "zen-browser"
        "ttf-nerd-fonts-symbols"
        "ttf-fira-code"

        # Optional dependencies of the packages above, made hard here.
        # Choosing which optional features to enable is this metapackage's job.
        # The packages themselves keep them optional to stay usable standalone.
        "cava"                   # dms-shell: audio visualizer
        "i2c-tools"              # dms-shell: external monitor brightness
        "matugen"                # dms-shell: wallpaper-based theming
        "qt6-multimedia"         # dms-shell: sound effects
        "upower"                 # dms-shell: battery and power profile widgets
        "power-profiles-daemon"  # dms-shell: power profile switching
        "ffmpeg"                 # zen-browser: H.264 and AV1 playback
        "libpulse"               # zen-browser: audio through pipewire-pulse
        "libnotify"              # zen-browser: desktop notifications
    )

    install -Dm644 "$srcdir/greetd-config.toml" \
        "$pkgdir/usr/share/doc/$pkgname/greetd-config.toml"
    install -Dm644 "$srcdir/greetd-greeter.pam" \
        "$pkgdir/etc/pam.d/greetd-greeter"

    install -dm755 "$pkgdir/etc/xdg/userspawn/dinit.d/boot.d"
    for svc in pipewire pipewire-pulse wireplumber; do
        ln -s "/etc/dinit.d/user/$svc" \
            "$pkgdir/etc/xdg/userspawn/dinit.d/boot.d/$svc"
    done
}
